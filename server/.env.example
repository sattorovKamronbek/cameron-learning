# Copy to .env and fill values
DATABASE_URL="postgresql://user:password@localhost:5432/projectdb?schema=public"
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
# Used by the Practice runner to validate the browser's Supabase session. This
# is a publishable/anon key, not a service-role secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com
ADMIN_BOOTSTRAP_EMAILS=admin1@gmail.com,admin2@gmail.com
PORT=4000
# Optional supplemental AI review. Leave empty to use only the deterministic,
# local structural similarity detector; this must point to a trusted service.
AI_SIMILARITY_REVIEW_URL=
AI_SIMILARITY_REVIEW_TOKEN=
CODE_SIMILARITY_THRESHOLD=0.82
JUDGE_WORKDIR=/tmp/judge
# Server-only OpenAI-compatible formatter configuration. Do not expose either
# key in VITE_ variables or the browser bundle.
AI_PDF_FORMATTER_API_KEY=
AI_PDF_FORMATTER_MODEL=
# Optional: defaults to https://api.openai.com/v1/chat/completions
AI_PDF_FORMATTER_URL=
# Required in production: absolute path to a Chrome/Chromium binary used only
# for deterministic HTML-to-PDF rendering.
PDF_CHROME_EXECUTABLE_PATH=
# Optional per-user protection. Defaults are 6 requests / 15 minutes.
CONTEST_PDF_RATE_LIMIT=6
CONTEST_PDF_RATE_WINDOW_MS=900000
# Optional per-user protection for public-sample practice runner.
PRACTICE_PREVIEW_RATE_LIMIT=20
PRACTICE_PREVIEW_RATE_WINDOW_MS=900000
